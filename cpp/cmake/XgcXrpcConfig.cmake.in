@PACKAGE_INIT@
set(XgcXrpc_FOUND TRUE)
unset(XgcXrpc_NOT_FOUND_MESSAGE)
set(_XgcXrpc_components ${XgcXrpc_FIND_COMPONENTS})
set(_XgcXrpc_default_components FALSE)
if(NOT _XgcXrpc_components)
  set(_XgcXrpc_components unix policy diagnostics http)
  set(_XgcXrpc_default_components TRUE)
endif()
if("http" IN_LIST _XgcXrpc_components OR "grpc" IN_LIST _XgcXrpc_components)
  list(APPEND _XgcXrpc_components unix policy diagnostics)
endif()
if("http" IN_LIST _XgcXrpc_components)
  list(APPEND _XgcXrpc_components bootstrap)
endif()
if("bootstrap" IN_LIST _XgcXrpc_components)
  list(APPEND _XgcXrpc_components unix)
endif()
if("diagnostics" IN_LIST _XgcXrpc_components)
  list(APPEND _XgcXrpc_components policy)
endif()
list(REMOVE_DUPLICATES _XgcXrpc_components)
foreach(_XgcXrpc_component IN LISTS _XgcXrpc_components)
  set(XgcXrpc_${_XgcXrpc_component}_FOUND FALSE)
endforeach()

# Dependency order permits each export to validate only its own library.
foreach(_XgcXrpc_export Unix Policy Diagnostics Bootstrap Http Grpc)
  string(TOLOWER "${_XgcXrpc_export}" _XgcXrpc_component)
  if(NOT _XgcXrpc_component IN_LIST _XgcXrpc_components)
    continue()
  endif()
  if(_XgcXrpc_component STREQUAL "diagnostics" AND NOT XgcXrpc_policy_FOUND)
    continue()
  endif()
  if(_XgcXrpc_component STREQUAL "bootstrap" AND NOT XgcXrpc_unix_FOUND)
    continue()
  endif()
  if((_XgcXrpc_component STREQUAL "http" OR _XgcXrpc_component STREQUAL "grpc")
      AND NOT (XgcXrpc_unix_FOUND AND XgcXrpc_policy_FOUND AND XgcXrpc_diagnostics_FOUND))
    continue()
  endif()
  if(_XgcXrpc_component STREQUAL "http" AND NOT XgcXrpc_bootstrap_FOUND)
    continue()
  endif()
  # Optional development packages may overlay a base-only installation.
  # Installed exports, rather than this Config's build options, decide which
  # components exist. Never search native gRPC dependencies without its export.
  set(_XgcXrpc_export_file "${CMAKE_CURRENT_LIST_DIR}/XgcXrpc${_XgcXrpc_export}Targets.cmake")
  if(NOT EXISTS "${_XgcXrpc_export_file}")
    continue()
  endif()
  if(_XgcXrpc_component STREQUAL "grpc")
    if(XgcXrpc_FIND_REQUIRED_grpc)
      include(CMakeFindDependencyMacro)
      find_dependency(Threads)
      find_dependency(Protobuf)
      find_dependency(gRPC 1.51 CONFIG)
    else()
      # Optional gRPC must not inherit the package's REQUIRED requirement.
      # Clear prior lookup results, including when a search is now disabled.
      set(Threads_FOUND FALSE)
      find_package(Threads QUIET)
      if(NOT Threads_FOUND)
        continue()
      endif()
      set(Protobuf_FOUND FALSE)
      find_package(Protobuf QUIET)
      if(NOT Protobuf_FOUND)
        continue()
      endif()
      set(gRPC_FOUND FALSE)
      find_package(gRPC 1.51 CONFIG QUIET)
      if(NOT gRPC_FOUND)
        continue()
      endif()
    endif()
  endif()
  include("${_XgcXrpc_export_file}")
  set(XgcXrpc_${_XgcXrpc_component}_FOUND TRUE)
endforeach()
foreach(_XgcXrpc_component IN LISTS _XgcXrpc_components)
  if(NOT XgcXrpc_${_XgcXrpc_component}_FOUND)
    if(_XgcXrpc_default_components OR XgcXrpc_FIND_REQUIRED_${_XgcXrpc_component})
      set(XgcXrpc_FOUND FALSE)
      set(XgcXrpc_NOT_FOUND_MESSAGE "XgcXrpc component '${_XgcXrpc_component}' is unavailable")
    endif()
  endif()
endforeach()
check_required_components(XgcXrpc)
unset(_XgcXrpc_components)
unset(_XgcXrpc_default_components)
unset(_XgcXrpc_component)
unset(_XgcXrpc_export)
unset(_XgcXrpc_export_file)
