      "type": "integer",
      "unit": "calls",
      "default": 32,
      "dynamic": false,
      "capability": "host"
    },
    {
      "name": "MAX_HEADER_BYTES",
      "type": "integer",
      "unit": "bytes",
      "default": 16384,
      "dynamic": false,
      "capability": "http"
    },
    {
      "name": "MAX_REQUEST_BYTES",
      "type": "integer",
      "unit": "bytes",
      "default": 1048576,
      "dynamic": false,
      "capability": "rpc"
